    "Your data is available on this device, but iCloud has not synced yet. Tap to retry." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بياناتك متاحة على هذا الجهاز، لكن iCloud لم تتم مزامنته بعد. اضغط لإعادة المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten sind auf diesem Gerät verfügbar, aber iCloud wurde noch nicht synchronisiert. Zum Wiederholen tippen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
