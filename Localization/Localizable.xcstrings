          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli utracisz wszystkie urządzenia, ten klucz będzie jedynym sposobem odzyskania kodów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você perder todos os dispositivos, esta chave será a única forma de recuperar seus códigos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы потеряете все устройства, этот ключ будет единственным способом восстановить коды."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณสูญเสียอุปกรณ์ทั้งหมด คีย์นี้คือวิธีเดียวที่จะกู้คืนรหัสของคุณ"
