          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデバイスを失った場合、このキーだけがコードを復元する方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 기기를 잃어버리면 이 키만이 코드를 복구할 수 있는 방법입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
