{
  "sourceLanguage" : "en",
  "strings" : {
    "A recovery key is configured. Keep the recovery key you saved previously safe." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إعداد مفتاح استرداد. احتفظ بأمان بمفتاح الاسترداد الذي حفظته سابقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wiederherstellungsschlüssel ist eingerichtet. Bewahre den zuvor gespeicherten Schlüssel sicher auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de recuperación está configurada. Guarda de forma segura la clave que guardaste anteriormente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clé de récupération est configurée. Conservez précieusement la clé enregistrée précédemment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुनर्प्राप्ति कुंजी कॉन्फ़िगर है। पहले सहेजी गई पुनर्प्राप्ति कुंजी को सुरक्षित रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci pemulihan telah dikonfigurasi. Simpan dengan aman kunci pemulihan yang telah Anda simpan sebelumnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una chiave di recupero è configurata. Conserva al sicuro la chiave salvata in precedenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元キーは設定済みです。以前保存した復元キーを安全に保管してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구 키가 구성되었습니다. 이전에 저장한 복구 키를 안전하게 보관하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een herstelsleutel ingesteld. Bewaar de eerder opgeslagen herstelsleutel op een veilige plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz odzyskiwania jest skonfigurowany. Bezpiecznie przechowuj wcześniej zapisany klucz odzyskiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma chave de recuperação está configurada. Guarde com segurança a chave salva anteriormente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ восстановления настроен. Надёжно сохраните ранее сохранённый ключ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่าคีย์กู้คืนแล้ว โปรดเก็บคีย์ที่บันทึกไว้ก่อนหน้าอย่างปลอดภัย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kurtarma anahtarı yapılandırıldı. Daha önce kaydettiğiniz kurtarma anahtarını güvenle saklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ відновлення налаштовано. Надійно збережіть ключ, який ви зберегли раніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa khôi phục đã được thiết lập. Hãy bảo quản an toàn khóa đã lưu trước đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复密钥已配置。请妥善保管之前保存的恢复密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復原金鑰已設定。請妥善保管先前保存的復原金鑰。"
          }
        }
      }
    },
