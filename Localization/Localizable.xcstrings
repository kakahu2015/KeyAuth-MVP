    "If you lose all devices, this key is the only way to recover your codes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا فقدت جميع أجهزتك، فهذا المفتاح هو الطريقة الوحيدة لاسترداد رموزك."
          }
        },
        "de" : {
