          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si pierdes todos tus dispositivos, esta clave es la única forma de recuperar tus códigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
