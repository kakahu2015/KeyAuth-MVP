          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आपके सभी डिवाइस खो जाएँ, तो यह कुंजी आपके कोड पुनर्प्राप्त करने का एकमात्र तरीका है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
